{
  "name": "yomu",
  "displayName": "Yomu - Markdown Reader with Japanese Typography",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "shou6",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1F2937",
    "theme": "dark"
  },
  "homepage": "https://github.com/shou6/yomu#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shou6/yomu.git"
  },
  "bugs": {
    "url": "https://github.com/shou6/yomu/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "reader",
    "japanese",
    "typography",
    "viewer"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "files": [
    "dist/extension.js",
    "dist/webview.js",
    "dist/mermaid.min.js",
    "media/**",
    "fonts/**",
    "resources/**",
    "l10n/**",
    "package.nls.json",
    "package.nls.ja.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "yomu.reader",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "yomu.openInReader",
        "title": "%command.openInReader%",
        "category": "Yomu",
        "icon": {
          "light": "resources/reader-light.svg",
          "dark": "resources/reader-dark.svg"
        }
      },
      {
        "command": "yomu.toggleFocusMode",
        "title": "%command.toggleFocusMode%",
        "category": "Yomu"
      },
      {
        "command": "yomu.openInBrowser",
        "title": "%command.openInBrowser%",
        "category": "Yomu",
        "icon": "$(file-pdf)"
      },
      {
        "command": "yomu.enableFocusMode",
        "title": "%command.enableFocusMode%",
        "category": "Yomu",
        "icon": "$(eye)"
      },
      {
        "command": "yomu.disableFocusMode",
        "title": "%command.disableFocusMode%",
        "category": "Yomu",
        "icon": "$(eye-closed)"
      },
      {
        "command": "yomu.openInTextEditor",
        "title": "%command.openInTextEditor%",
        "category": "Yomu",
        "icon": "$(go-to-file)"
      },
      {
        "command": "yomu.revealHeading",
        "title": "%command.revealHeading%",
        "category": "Yomu"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yomu.openInReader",
          "when": "resourceExtname == .md && activeCustomEditorId != yomu.reader",
          "group": "navigation"
        },
        {
          "command": "yomu.enableFocusMode",
          "when": "activeCustomEditorId == yomu.reader && !config.yomu.focusMode",
          "group": "navigation"
        },
        {
          "command": "yomu.disableFocusMode",
          "when": "activeCustomEditorId == yomu.reader && config.yomu.focusMode",
          "group": "navigation"
        },
        {
          "command": "yomu.openInBrowser",
          "when": "activeCustomEditorId == yomu.reader",
          "group": "navigation"
        },
        {
          "command": "yomu.openInTextEditor",
          "when": "activeCustomEditorId == yomu.reader",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "yomu.enableFocusMode",
          "when": "!config.yomu.focusMode"
        },
        {
          "command": "yomu.disableFocusMode",
          "when": "config.yomu.focusMode"
        },
        {
          "command": "yomu.openInBrowser",
          "when": "activeCustomEditorId == yomu.reader"
        },
        {
          "command": "yomu.openInTextEditor",
          "when": "activeCustomEditorId == yomu.reader"
        },
        {
          "command": "yomu.revealHeading",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yomu",
          "title": "Yomu",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "yomu": [
        {
          "id": "yomu.outline",
          "name": "%view.outline%"
        },
        {
          "id": "yomu.history",
          "name": "%view.history%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "yomu.outline",
        "contents": "%viewsWelcome.outline%",
        "when": "!yomu.readerActive"
      },
      {
        "view": "yomu.history",
        "contents": "%viewsWelcome.history%"
      }
    ],
    "configuration": {
      "title": "Yomu",
      "properties": {
        "yomu.theme": {
          "type": "string",
          "enum": [
            "paper",
            "sepia",
            "dark",
            "vscode"
          ],
          "enumDescriptions": [
            "%config.theme.paper%",
            "%config.theme.sepia%",
            "%config.theme.dark%",
            "%config.theme.vscode%"
          ],
          "default": "paper",
          "description": "%config.theme%"
        },
        "yomu.layout.maxWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 820,
          "description": "%config.layout.maxWidth%"
        },
        "yomu.layout.align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "center",
          "description": "%config.layout.align%"
        },
        "yomu.layout.padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 32,
          "description": "%config.layout.padding%"
        },
        "yomu.font.family": {
          "type": "string",
          "default": "'Segoe UI', 'Helvetica Neue', Helvetica, Arial, 'Noto Sans JP', 'BIZ UDPGothic', sans-serif",
          "description": "%config.font.family%"
        },
        "yomu.font.codeFamily": {
          "type": "string",
          "default": "",
          "description": "%config.font.codeFamily%"
        },
        "yomu.font.size": {
          "type": "number",
          "minimum": 8,
          "maximum": 72,
          "default": 16,
          "description": "%config.font.size%"
        },
        "yomu.font.lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "default": 1.8,
          "description": "%config.font.lineHeight%"
        },
        "yomu.code.foldLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 20,
          "description": "%config.code.foldLines%"
        },
        "yomu.customCss": {
          "type": "string",
          "default": "",
          "description": "%config.customCss%"
        },
        "yomu.focusMode": {
          "type": "boolean",
          "default": false,
          "description": "%config.focusMode%"
        },
        "yomu.outline.revealOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "%config.outline.revealOnOpen%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "check": "npm run compile && npm run test:unit && npm run lint:md && npm run format:check && npm run verify:package",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "node -e \"fs.rmSync('out',{recursive:true,force:true})\" && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && mocha",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,mjs,json}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,mjs,json}\" \".vscode/*.json\"",
    "test": "vscode-test",
    "vsix": "vsce package",
    "try": "node scripts/try-extension.js",
    "test:unit": "npm run compile-tests && mocha",
    "test:integration:local": "node scripts/test-integration-local.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "verify:package": "npm run compile-tests && node scripts/verify-package.js",
    "icon": "node scripts/generate-icon.js"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.23.3",
    "mocha": "^12.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
